# Скопируйте в .env и замените значение своим ключом. Не публикуйте .env.
# На сервере задавайте ключи через окружение службы; переменные окружения имеют приоритет.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
# Необязательно: отдельная модель для проверки изображений; по умолчанию OPENAI_MODEL.
OPENAI_VISION_MODEL=gpt-4.1-mini
AVAILABLE_MATERIAL_TYPES=image

# Озвучка: Gemini TTS → Nova-2 + независимый OpenAI ASR → GPT-проверка. Ключи только локально.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Необязательно: укажите свой реальный контакт по правилам Wikimedia User-Agent.
# WIKIMEDIA_USER_AGENT="SmartgramBot/0.1 (contact: your_email_here)"

# Необязательно: подтверждённый абсолютный путь к существующей папке Google Drive для ревью.
# Перед передачей проверяется smartgram_sync_target.json. Личный путь храните только в .env.
SMARTGRAM_REVIEW_SYNC_DIR=

# Исследователь: два этапа, настройки не меняют OPENAI_MODEL остальных систем.
RESEARCH_SEARCH_MODEL=gpt-6-luna
RESEARCH_SEARCH_REASONING_EFFORT=medium
RESEARCH_SEARCH_CONTEXT_SIZE=medium
RESEARCH_MAX_TOOL_CALLS_PER_ROUND=8
RESEARCH_SEARCH_TIMEOUT_SECONDS=180
RESEARCH_ASSESSMENT_MODEL=gpt-6-luna
RESEARCH_ASSESSMENT_REASONING_EFFORT=low
RESEARCH_ASSESSMENT_TIMEOUT_SECONDS=120
RESEARCH_MAX_ROUNDS=2

# Сценарист: два смысловых шага; настройки схемы сайта v5 research-script-visual-v1.
SCRIPT_WRITING_MODEL=gpt-6-luna
SCRIPT_WRITING_REASONING_EFFORT=medium
SCRIPT_WRITING_TIMEOUT_SECONDS=120
SCRIPT_WRITING_MAX_RETRIES=0
SCRIPT_WRITING_PROMPT_FILE=prompts/script_writing.txt
SCRIPT_VERIFICATION_MODEL=gpt-6-luna
SCRIPT_VERIFICATION_REASONING_EFFORT=medium
SCRIPT_VERIFICATION_TIMEOUT_SECONDS=180
SCRIPT_VERIFICATION_MAX_RETRIES=0
SCRIPT_VERIFICATION_PROMPT_FILE=prompts/script_verification.txt
SCRIPT_VERIFICATION_MAX_TOOL_CALLS=8
SCRIPT_VERIFICATION_CONTEXT_SIZE=medium
SCRIPT_TARGET_MIN_SECONDS=30
SCRIPT_TARGET_MAX_SECONDS=45
SCRIPT_MAX_REVISIONS=2

# Учёт расходов: административный ключ только для GET Costs/Usage, не для генерации.
# ID — несекретные идентификаторы. При пустых ID код ищет рабочий ключ однозначно через Admin API.
OPENAI_ADMIN_KEY=
OPENAI_BILLING_PROJECT_ID=
OPENAI_BILLING_API_KEY_IDS=
# По умолчанию: тайм-аут чтения 20 секунд, максимум 2 повтора временных ошибок.
OPENAI_BILLING_TIMEOUT_SECONDS=
OPENAI_BILLING_MAX_RETRIES=

# Полная озвучка. Переменные окружения имеют приоритет над .env.
VOICE_TTS_PROVIDER=gemini
VOICE_TTS_API=interactions
VOICE_TTS_MODEL=gemini-3.8-flash-tts
VOICE_TTS_VOICE=Kore
VOICE_TTS_STYLE="Русскоязычный профессиональный диктор. Нейтральное литературное русское произношение, естественная разговорная интонация, правильные ударения и смысловые паузы. Спокойная, живая подача короткого научно-популярного видео. Нормальный темп без спешки и растягивания слов; без рекламного пафоса и театральности. GPS произносится “джи-пи-эс”"
VOICE_TTS_ADAPTER_VERSION=gemini-interactions-wav-v1
VOICE_TTS_TIMEOUT_SECONDS=180
VOICE_TTS_MAX_RETRIES=1
VOICE_MAX_TEXT_REGENERATIONS=1
VOICE_NARRATOR_PROMPT_FILE=prompts/voice_narrator.txt
VOICE_ASR_PROVIDER=deepgram
# Nova-2 проверена на трёх сохранённых WAV; переключение модели только явной настройкой.
VOICE_ASR_MODEL=nova-2
VOICE_ASR_LANGUAGE=ru
VOICE_ASR_PUNCTUATE=true
VOICE_ASR_SMART_FORMAT=false
VOICE_ASR_TIMEOUT_SECONDS=120
VOICE_ASR_MAX_RETRIES=1
VOICE_CHECK_MODEL=gpt-6-luna
VOICE_CHECK_REASONING_EFFORT=low
VOICE_CHECK_TIMEOUT_SECONDS=120
VOICE_CHECK_MAX_RETRIES=1
VOICE_CHECK_PROMPT_FILE=prompts/voice_check.txt
VOICE_CONFIRM_MODEL=gpt-transcribe
VOICE_CONFIRM_TIMEOUT_SECONDS=120
VOICE_CONFIRM_MAX_RETRIES=1
VOICE_TIMING_TOLERANCE_SECONDS=0.02

# Локальный монтаж на Mac Apple Silicon. Это примеры путей, не проверка установки.
# Для фактического пути: brew --prefix ffmpeg-full; проверка: media_check.py --save-paths.
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
SUBTITLE_FONT_PATH=/System/Library/Fonts/Supplemental/Arial.ttf

# Визуальные материалы/монтаж: модели, лимиты и явное семейство Arial — в visuals_editing_config.json.
# После неудачного подбора фото — ограниченная генерация OpenAI Images через OPENAI_API_KEY.
# Параметры visuals.generation: gpt-image-2.5-flare, medium, n=1, 1024x1536.
# Новые ключи и сервисы не требуются. Поиск материалов не требует WAV.

# Стратегия изображений, лимиты GET/повторов и SVG: visuals_editing_config.json.
# Для неё нужен только OPENAI_API_KEY; Google/Deepgram и аудио не требуются.

# Необязательный ключ фото Pexels. Без него автоматически используется Wikimedia.
PEXELS_API_KEY=

# Optional Gemini-only local HTTP CONNECT proxy (VPN client runs separately).
# Leave empty until the local proxy is configured and tested on this machine.
GEMINI_HTTP_PROXY=

